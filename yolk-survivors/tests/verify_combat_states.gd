extends "res://tests/verify_status_system.gd"
func verify():
	load("res://tests/progression_fixture.gd").prepare(root)
	var arena = load("res://scenes/arena/arena.tscn").instantiate()
	root.add_child(arena)
	current_scene = arena
	var global = root.get_node("Global")
	global.main_player_selected = arena.selection_panel.player_list[0]
	global.main_weapon_selected = load("res://resources/items/weapons/range/knifer/item_knifer_1.tres")
	arena._on_level_selected(0)
	arena.spawner.spawn_timer.stop()
	arena.stage_mechanics.stop()
	var player = global.player
	player.set_process(false)
	for weapon in player.current_weapons: weapon.set_process(false)
	var victim = enemy_at(arena, player.global_position + Vector2(200, 0))
	var other = enemy_at(arena, victim.global_position + Vector2(60, 0))
	var contact = load("res://scenes/components/hitbox_component.tscn").instantiate()
	arena.add_child(contact)
	contact.setup(10, false, 0, player)
	assert(victim.get_active_statuses().is_empty())
	var fire = load("res://resources/statuses/fueguito_fire.tres").duplicate()
	load("res://effects/status_controller.gd").apply_effect(victim, fire, contact)
	var burns = victim.get_children().filter(func(node): return node.get_script() == load("res://effects/fire_status.gd"))
	assert(victim.has_status_named("Burning"))
	var second_fire = fire.duplicate()
	second_fire.set_meta("stack_id", "second")
	load("res://effects/status_controller.gd").apply_effect(victim, second_fire, contact)
	burns[0].remaining = 0
	burns[0].queue_free()
	assert(victim.has_status_named("Burning"), "One expired source cannot remove another active burn")
	load("res://effects/status_controller.gd").apply_effect(victim, load("res://resources/statuses/electricity_default.tres"), contact)
	assert(victim.has_status_named("Shoked") and not victim.has_status_named("Slow"))
	victim.apply_slow(0.5, 1)
	victim.immobilize_for(0.2)
	assert(victim.has_status_named("Slow") and victim.has_status_named("Rooted"))
	assert(victim.status_controller.control_label.text.contains("Root"))
	victim.status_controller._process(0.3)
	assert(not victim.has_status_named("Rooted") and victim.has_status_named("Slow"))
	victim.pin_for(contact)
	assert(victim.has_status_named("Rooted"))
	victim.release_pin(contact)
	victim.slow_left = 0
	victim.status_controller.clear()
	assert(victim.get_active_statuses().is_empty())
	var item = load("res://resources/items/weapons/range/fusilli_launcher/item_fusilli_launcher_1.tres")
	var shot = item.stats.projectile_scene.instantiate()
	arena.add_child(shot)
	shot.set_process(false)
	shot.global_position = victim.global_position
	shot.setup_projectile(Vector2.RIGHT * 900, 10, false, 0, player, 500)
	shot.configure_effects(item.stats.ranged_settings)
	assert(shot.hitbox.launch_on_hit and shot.hitbox.launch_damage == 10.0 and is_equal_approx(shot.hitbox.base_damage, 3.0))
	assert(item.has_tag(6))
	victim.get_node("HurtboxComponent")._on_area_entered(shot.hitbox)
	assert(victim.has_status_named("Airbourne"))
	assert(victim.launch_velocity.x > 0 and is_zero_approx(victim.launch_velocity.y))
	assert(victim.status_controller.control_label.text == "Air")
	await physics_frame
	await physics_frame
	var hp = other.health_component.current_health
	victim._move_launched(0.1)
	assert(other.health_component.current_health == hp - 10.0, "Airbourne collides with other enemies")
	victim._move_launched(0.1)
	assert(other.health_component.current_health == hp - 10.0, "One collision per victim per launch")
	victim._move_launched(0.3)
	assert(not victim.has_status_named("Airbourne"))
	for tier in range(1, 5):
		var glove = load("res://resources/items/weapons/melee/mitten/item_mitten_%d.tres" % tier)
		assert(glove.has_tag(6))
		assert(glove.stats.melee_settings.collision_damage_multiplier > glove.stats.melee_settings.direct_damage_multiplier)
	print("PASS combat states: multi-source burning, shock without slow, root/slow overlap, expiry, Fusilli launch collisions, tags and tiers")
	quit()
