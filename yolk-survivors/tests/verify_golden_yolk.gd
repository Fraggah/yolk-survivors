extends "res://tests/verify_status_system.gd"

func verify():
	load("res://tests/progression_fixture.gd").prepare(root)
	var global = root.get_node("Global")
	var arena = load("res://scenes/arena/arena.tscn").instantiate()
	root.add_child(arena)
	current_scene = arena
	global.main_player_selected = load("res://resources/units/players/player_well_rounded.tres")
	var player = global.get_selected_player()
	arena.add_child(player)
	player.set_process(false)
	await process_frame
	var shop = arena.shop_panel
	var manager = player.passive_items
	var gold = load("res://resources/items/passives/catalogue/item_078.tres")
	for index in 30: shop._on_item_purchased(gold)
	assert(manager.golden_yolks == 30 and shop.passive_container.get_child_count() == 0)
	var helper = load("res://resources/items/golden_enhancement.gd")
	assert(helper.roll_outcome(0.0) == -1.0 and helper.roll_outcome(0.249) == -1.0)
	assert(helper.roll_outcome(0.25) == 0.1 and helper.roll_outcome(0.65) == 0.25)
	assert(helper.roll_outcome(0.88) == 0.5 and helper.roll_outcome(0.98) == 1.0)
	shop.golden_control.confirmation.confirmed.emit()
	assert(shop.golden_control.selecting and manager.golden_yolks == 30)
	shop.golden_control.cancel_selection()
	assert(not shop.golden_control.selecting and manager.golden_yolks == 30)
	var paprika = load("res://resources/items/passives/catalogue/item_001.tres")
	var base_life = player.stats.life_steal
	var base_regen = player.stats.hp_regen
	shop._on_item_purchased(paprika)
	shop._on_item_purchased(paprika)
	var normal = find_card(shop.passive_container, paprika)
	assert(normal.quantity == 2)
	assert(shop.apply_golden_yolk(normal, 0.7))
	assert(manager.golden_yolks == 29 and normal.quantity == 1)
	var improved = shop.passive_container.get_child(1)
	assert(improved.item != paprika and improved.quantity == 1)
	assert(is_equal_approx(player.stats.life_steal, base_life + 4.5))
	assert(is_equal_approx(player.stats.hp_regen, base_regen - 1.75))
	assert(paprika.add_value == 2 and paprika.add_value_2 == -1)
	assert(improved.item_icon.material != null)
	assert(shop.apply_golden_yolk(improved, 0.99))
	assert(improved.item.golden_perfect and improved.has_node("GoldenSparkles"))
	assert(is_equal_approx(player.stats.life_steal, base_life + 7.0))
	assert(is_equal_approx(player.stats.hp_regen, base_regen - 1.0))
	player.stats.apply_stat_change("life_steal", 7)
	assert(shop.apply_golden_yolk(improved, 0.0))
	assert(is_equal_approx(player.stats.life_steal, base_life + 9.0))
	assert(is_equal_approx(player.stats.hp_regen, base_regen - 1.0))
	assert(manager.count("paprika") >= 0)
	var liquidation = load("res://resources/items/passives/catalogue/item_077.tres")
	shop._on_item_purchased(liquidation)
	assert(shop.apply_golden_yolk(find_card(shop.passive_container, liquidation), 0.0))
	assert(liquidation.available_for(player) and manager.count("liquidation") == 0)
	assert(shop._eligible_shop_items().has(liquidation))
	assert(manager.liquidation_data == null)
	shop._on_item_purchased(liquidation)
	assert(manager.count("liquidation") == 1 and not liquidation.available_for(player))
	assert(not shop._eligible_shop_items().has(liquidation))
	assert(manager.liquidation_data == liquidation)
	var oil = load("res://resources/items/passives/catalogue/item_056.tres")
	shop._on_item_purchased(oil)
	var oil_card = find_card(shop.passive_container, oil)
	assert(shop.apply_golden_yolk(oil_card, 0.9))
	assert(is_equal_approx(player.stats.fire_interval_reduction, 0.075))
	assert(is_equal_approx(player.stats.fire_duration_reduction, 0.05))
	assert(shop.apply_golden_yolk(oil_card, 0.0))
	assert(is_zero_approx(player.stats.fire_interval_reduction) and is_zero_approx(player.stats.fire_duration_reduction))
	var thermal = load("res://resources/items/passives/catalogue/item_073.tres")
	shop._on_item_purchased(thermal)
	var thermal_card = find_card(shop.passive_container, thermal)
	assert(shop.apply_golden_yolk(thermal_card, 0.9))
	assert(is_equal_approx(manager.burning_regen_total, 1.5))
	assert(shop.apply_golden_yolk(thermal_card, 0.0))
	assert(is_zero_approx(manager.burning_regen_total))
	var apron = load("res://resources/items/passives/catalogue/item_086.tres")
	player.stats.apply_stat_change("armor", 3)
	var health_before = player.stats.health
	shop._on_item_purchased(apron)
	var apron_card = find_card(shop.passive_container, apron)
	assert(is_equal_approx(player.stats.health, health_before + 6))
	assert(shop.apply_golden_yolk(apron_card, 0.7))
	assert(is_equal_approx(player.stats.health, health_before + 7.5))
	assert(shop.apply_golden_yolk(apron_card, 0.0))
	assert(is_equal_approx(player.stats.health, health_before))
	var arm = load("res://resources/items/passives/catalogue/item_079.tres")
	shop._on_item_purchased(arm)
	var arm_card = find_card(shop.passive_container, arm)
	assert(shop.apply_golden_yolk(arm_card, 0.9))
	assert(player.get_weapon_limit() == 7)
	assert(shop.apply_golden_yolk(arm_card, 0.99))
	assert(player.get_weapon_limit() == 8)
	for index in 2:
		shop._on_item_purchased(arm)
		assert(shop.apply_golden_yolk(find_card(shop.passive_container, arm), 0.99))
	assert(player.get_weapon_limit() == 12 and not arm.available_for(player))
	var spatula = load("res://resources/items/weapons/melee/spatula/item_spatula_1.tres")
	for index in 12: shop._on_item_purchased(spatula)
	assert(player.current_weapons.size() == 12 and global.equipped_weapons.size() == 12)
	var weapon_card = shop.weapon_container.get_child(0)
	var damage = spatula.stats.damage
	assert(shop.apply_golden_yolk(weapon_card, 0.7))
	assert(is_equal_approx(weapon_card.item.stats.damage, damage * 1.25))
	assert(spatula.stats.damage == damage)
	assert(weapon_card.weapon_instance.sprite_2d.has_node("GoldenOverlay"))
	global.coins = 10000
	assert(shop.try_purchase_item(spatula))
	assert(weapon_card.item.item_tier == 1 and weapon_card.item.golden_multiplier == 1.25)
	assert(weapon_card.weapon_instance.sprite_2d.has_node("GoldenOverlay"))
	assert(shop.apply_golden_yolk(weapon_card, 0.0))
	assert(player.current_weapons.size() == 11 and global.equipped_weapons.size() == 11)
	var coin = load("res://resources/items/passives/catalogue/item_034.tres")
	var cards = shop.passive_container.get_child_count()
	shop._on_item_purchased(coin)
	assert(shop.passive_container.get_child_count() == cards)
	print("PASS golden yolk: outcomes, stored charges, cancel, split copy, exact stats, destruction, unique reoffering and repurchase, oil, perfect slots, 12 weapons, visuals, consumables")
	arena.queue_free()
	await process_frame
	quit()

func find_card(container, item):
	for card in container.get_children():
		if card.item == item and not card.is_queued_for_deletion(): return card
	assert(false, "Owned item card missing")
	return null
