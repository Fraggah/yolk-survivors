extends SceneTree
func _initialize(): call_deferred("verify")
func verify():
	var pool=root.get_node("CombatTexts")
	var global=root.get_node("Global")
	pool.clear()
	global.game_paused=false
	for i in pool.CAPACITY+100:
		var text=pool.acquire()
		text.global_position=Vector2(i,0)
		text.setup_text(str(i),Color.WHITE)
	assert(pool.created<=pool.CAPACITY and pool.active.size()==pool.active_limit)
	var created: int=pool.created
	assert(get_nodes_in_group("combat_texts").size()==pool.active_limit)
	var text=pool.active.back()
	global.game_paused=true
	text._process(0.5)
	assert(text.elapsed==0)
	global.game_paused=false
	text._process(0.5)
	assert(text.scale.x>0 and text.visible)
	text._process(2)
	assert(not text.visible and not text.is_processing())
	pool.clear()
	pool.clear()
	assert(pool.active.is_empty() and pool.available.size()==created)
	assert(get_nodes_in_group("combat_texts").is_empty())
	var again=pool.acquire()
	again.setup_text("42",Color.RED)
	assert(again.modulate==Color.RED and again.elapsed==0 and again.visible)
	assert(pool.created==created)
	pool.clear()
	var target=Node2D.new()
	root.add_child(target)
	pool.queue_damage(target,10,Color.WHITE,false)
	pool.queue_damage(target,3,Color.RED,true)
	pool._process(0)
	assert(pool.active.size()==1)
	assert(pool.active[0].label.text=="13" and pool.active[0].modulate==Color.RED)
	pool.queue_damage(target,5,Color.WHITE,false)
	pool.clear()
	pool._process(0)
	assert(pool.active.is_empty())
	# Text created after the wave-end clear must not survive the next-wave clear.
	global.game_paused = true
	var late_bonus = pool.acquire()
	late_bonus.setup_text("×2", Color.YELLOW)
	pool.queue_damage(target, 7, Color.WHITE, false)
	pool.clear()
	global.game_paused = false
	pool._process(0)
	assert(pool.active.is_empty() and pool.pending_damage.is_empty())
	assert(not late_bonus.visible and not late_bonus.is_processing())
	target.queue_free()
	print("PASS combat text pool: bounded nodes, oldest-slot reuse, animation, pause, expiry, clear and reactivation")
	quit()
