extends "res://tests/verify_status_system.gd"

func verify():
	load("res://tests/progression_fixture.gd").prepare(root)
	var global = root.get_node("Global")
	var arena = load("res://scenes/arena/arena.tscn").instantiate()
	root.add_child(arena)
	current_scene = arena
	global.main_player_selected = load("res://resources/units/players/player_well_rounded.tres")
	var player = global.get_selected_player()
	arena.add_child(player)
	player.set_process(false)
	await process_frame
	var manager = player.passive_items
	var controller = load("res://effects/status_controller.gd")
	var fire = load("res://effects/fire_status.gd")
	assert(controller.burning_enemy_count == 0)
	var first = enemy_at(arena, Vector2(500, 0))
	var second = enemy_at(arena, Vector2(900, 0))
	var template = load("res://scenes/components/hitbox_component.tscn").instantiate()
	arena.add_child(template)
	template.setup(1, false, 0, player)
	var settings = load("res://resources/status_effect.gd").new()
	settings.duration = 2.0
	fire.apply(first, "BurnA", template, settings)
	assert(controller.burning_enemy_count == 1 and player.stats.damage_percent == 0)
	var item = load("res://resources/items/passives/catalogue/item_084.tres")
	item.apply_passive_values()
	assert(player.stats.damage_percent == 10)
	player.stats.apply_stat_change("damage_percent", 7)
	var permanent = player.stats.damage_percent - 10.0
	var longer = settings.duplicate()
	longer.duration = 4.0
	fire.apply(first, "BurnB", template, longer)
	fire.apply(first, "BurnA", template, settings)
	assert(controller.burning_enemy_count == 1 and is_equal_approx(player.stats.damage_percent, permanent + 10), "count=%s damage=%s" % [controller.burning_enemy_count, player.stats.damage_percent])
	fire.apply(player, "SelfBurn", template, settings)
	assert(controller.burning_enemy_count == 1 and is_equal_approx(player.stats.damage_percent, permanent + 10), "count=%s damage=%s" % [controller.burning_enemy_count, player.stats.damage_percent])
	fire.apply(second, "BurnC", template, settings)
	assert(controller.burning_enemy_count == 2 and is_equal_approx(player.stats.damage_percent, permanent + 20))
	item.apply_passive_values()
	assert(is_equal_approx(player.stats.damage_percent, permanent + 40))
	first.get_node("BurnA")._process(2.01)
	assert(controller.burning_enemy_count == 2 and is_equal_approx(player.stats.damage_percent, permanent + 40))
	first.get_node("BurnB")._process(4.01)
	assert(controller.burning_enemy_count == 1 and is_equal_approx(player.stats.damage_percent, permanent + 20))
	second.health_component.take_damage(5000)
	assert(controller.burning_enemy_count == 0 and is_equal_approx(player.stats.damage_percent, permanent))
	var third = enemy_at(arena, Vector2(1300, 0))
	fire.apply(third, "BurnD", template, settings)
	assert(is_equal_approx(player.stats.damage_percent, permanent + 20))
	third.status_controller.clear()
	assert(controller.burning_enemy_count == 0 and is_equal_approx(player.stats.damage_percent, permanent))
	var fourth = enemy_at(arena, Vector2(1700, 0))
	fire.apply(fourth, "BurnE", template, settings)
	assert(is_equal_approx(player.stats.damage_percent, permanent + 20))
	fourth.destroy_enemy()
	assert(controller.burning_enemy_count == 0 and is_equal_approx(player.stats.damage_percent, permanent))
	var fifth = enemy_at(arena, Vector2(2100, 0))
	fire.apply(fifth, "BurnF", template, settings)
	assert(is_equal_approx(player.stats.damage_percent, permanent + 20))
	var record = manager.find_owned_record(item)
	var improved = load("res://resources/items/golden_enhancement.gd").improve(item, 0.25)
	manager.replace_owned(record, improved)
	assert(is_equal_approx(player.stats.damage_percent, permanent + 22.5))
	manager.replace_owned(record, null)
	assert(is_equal_approx(player.stats.damage_percent, permanent + 10))
	manager.replace_owned(manager.find_owned_record(item), null)
	assert(is_equal_approx(player.stats.damage_percent, permanent) and manager.flambe_damage_per_enemy == 0)
	fifth.queue_free()
	await process_frame
	assert(controller.burning_enemy_count == 0 and is_equal_approx(player.stats.damage_percent, permanent))
	print("PASS Flambeado: 10% per burning enemy/copy, event count, multi-source dedup, no self bonus, expiry/death/clear/retirement/free cleanup, permanent gains preserved, gold/removal")
	arena.queue_free()
	await process_frame
	assert(controller.burning_enemy_count == 0)
	quit()
