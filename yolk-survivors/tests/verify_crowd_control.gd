extends "res://tests/verify_status_system.gd"

func verify():
	load("res://tests/progression_fixture.gd").prepare(root)
	var arena = load("res://scenes/arena/arena.tscn").instantiate()
	root.add_child(arena)
	current_scene = arena
	var global = root.get_node("Global")
	global.main_player_selected = arena.selection_panel.player_list[0]
	global.main_weapon_selected = load("res://resources/items/weapons/range/fusilli_launcher/item_fusilli_launcher_1.tres")
	arena._on_level_selected(0)
	arena.spawner.spawn_timer.stop()
	arena.stage_mechanics.stop()
	var player = global.player
	player.set_process(false)
	for weapon in player.current_weapons: weapon.set_process(false)
	assert(player.stats.crowd_control == 0)
	var item = load("res://resources/items/passives/item_passive.gd").new()
	item.add_stats_id = "crowd_control"
	item.add_value = 50
	item.apply_passive_values()
	assert(player.stats.crowd_control == 50 and item.get_description().contains("50%"))
	player.stats.apply_stat_change("effects", 100)
	assert(is_equal_approx(player.stats.get_effect_damage(2.0, 0.5), 52.0))
	assert(is_equal_approx(player.stats.effective_slow(0.6), 0.4))
	var honey = load("res://resources/items/passives/catalogue/item_026.tres")
	honey.apply_passive_values()
	honey.apply_passive_values()
	assert(player.stats.slow_strength == 20.0)
	assert(is_equal_approx(player.stats.effective_slow(0.6), 0.28))
	assert(player.stats.crowd_control == 50.0, "Slow-only bonus must not strengthen Rooted or Airbourne")
	assert(is_equal_approx(player.stats.get_push_multiplier(), 1.0))
	var hit = load("res://scenes/components/hitbox_component.tscn").instantiate()
	arena.add_child(hit)
	hit.setup(10, false, 2, player)
	assert(hit.knockback_power == 2)
	player.stats.apply_stat_change("knockback", 15)
	hit.setup(10, false, 2, player)
	assert(hit.knockback_power == 17)
	var victim = enemy_at(arena, player.global_position + Vector2(200, 0))
	victim.immobilize_for(1, player.stats)
	assert(is_equal_approx(victim.status_controller.slows[0].left, 1.5))
	victim.status_controller.clear()
	var weapon = player.current_weapons[0]
	var shot = weapon.data.stats.projectile_scene.instantiate()
	arena.add_child(shot)
	shot.setup_projectile(Vector2.RIGHT * 900, 10, false, 0, player, 300)
	shot.configure_effects(weapon.data.stats.ranged_settings)
	assert(shot.hitbox.launch_speed == 780)
	assert(is_equal_approx(shot.hitbox.launch_duration, weapon.data.stats.ranged_settings.airbourne_duration * 1.5))
	assert(shot.hitbox.launch_damage == 3.5, "Control cannot increase collision damage")
	shot.queue_free()
	# A copied blast uses the template push once, even with final item modifiers.
	player.stats.set_final_modifiers({"knockback": 20, "crowd_control": 20})
	assert(is_equal_approx(player.stats.crowd_control, 80))
	hit.setup(10, false, 2, player)
	assert(is_equal_approx(hit.knockback_power, 20.4))
	var explosion = load("res://scenes/projectiles/ranged_area_effect.gd").new()
	arena.add_child(explosion)
	explosion.global_position = Vector2(-10000, -10000)
	explosion.setup(hit, load("res://resources/items/weapons/ranged_settings.gd").new(), false)
	assert(is_equal_approx(explosion.hit.knockback_power, 20.4), "Blast must not scale push twice")
	for upgrade in arena.upgrade_panel.upgrades:
		assert(upgrade.stat_id != "crowd_control", "Item-only stat must never appear on level-up")
	var stats_script = load("res://scenes/ui/stats/stats_container.gd")
	assert(stats_script.SECONDARY.has("crowd_control") and stats_script.PERCENT_STATS.has("crowd_control"))
	assert(not stats_script.PRIMARY.has("crowd_control"))
	player.stats.reset_player_stats()
	assert(player.stats.crowd_control == 0)
	print("PASS crowd control: item gain, slow strength, roots, push, Airbourne, final modifiers, blast inheritance, secondary panel and no level-up")
	quit()
