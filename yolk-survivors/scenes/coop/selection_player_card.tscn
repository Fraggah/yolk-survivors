[gd_scene format=3]

[node name="PlayerCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 130)
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_bottom = 8

[node name="Content" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Margin/Content"]
theme_override_constants/separation = 10

[node name="Icon" type="TextureRect" parent="Margin/Content/Header"]
custom_minimum_size = Vector2(56, 56)
expand_mode = 1
stretch_mode = 5
mouse_filter = 2

[node name="Name" type="Label" parent="Margin/Content/Header"]
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_font_sizes/font_size = 22
text = "P1"
autowrap_mode = 2

[node name="Confirm" type="Button" parent="Margin/Content/Header"]
custom_minimum_size = Vector2(70, 42)
size_flags_vertical = 4
focus_mode = 0
theme_override_font_sizes/font_size = 18
text = "Ready"

[node name="Description" type="RichTextLabel" parent="Margin/Content"]
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
scroll_active = false
mouse_filter = 2
text = "Hold A / X to join"

[node name="SoloNotice" type="PanelContainer" parent="Margin/Content"]
visible = false
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="Margin/Content/SoloNotice"]
theme_override_constants/margin_left = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_top = 7
theme_override_constants/margin_bottom = 7
mouse_filter = 2

[node name="Message" type="Label" parent="Margin/Content/SoloNotice/Margin"]
theme_override_font_sizes/font_size = 18
text = "Para jugar solo, desactivá Coop Game.\nO esperá a que se una otro jugador."
autowrap_mode = 2
mouse_filter = 2

[node name="Hold" type="ProgressBar" parent="Margin/Content"]
custom_minimum_size = Vector2(0, 16)
max_value = 1.0
step = 0.01
show_percentage = false
mouse_filter = 2
